# PyJHora API — copy to .env and fill in values (never commit .env)

# Required for POST /api/education-analysis (Gemini field selection in jyotish engine)
# Create at https://aistudio.google.com/apikey — starts with AIza or AQ.
GEMINI_API_KEY=your_key_here

# Optional LLM provider for education-analysis (default: auto-detect gemini)
# LLM_PROVIDER=gemini

# Optional — Google Maps / Places for geocoding endpoints
# GOOGLE_MAPS_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Optional — DynamoDB chart persistence
# AWS_REGION=ap-south-1
# DYNAMODB_TABLE_NAME=PyJHoraBirthCharts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Auth — JyotishUsers table (signup / login)
# DYNAMODB_USERS_TABLE_NAME=JyotishUsers
# DYNAMODB_PROFILES_TABLE_NAME=JyotishProfiles
# JWT_SECRET=change-me-to-a-long-random-string   # required on Render; required locally unless AUTH_FIXED_OTP is set
# AUTH_OTP_PEPPER=change-me-otp-pepper
# AUTH_FIXED_OTP=0000
# Leave unset in production (uses random 4-digit OTP; returned in API when SES is not configured).
# AUTH_DEV_EXPOSE_OTP=true
# SES_FROM_EMAIL=noreply@yourdomain.com
# SES_REGION=ap-south-1

# CORS (comma-separated origins, or * for all)
# CORS_ORIGINS=*
